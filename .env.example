# Copy to .env.local and fill in. Never commit real values.

# --- Database (Neon Postgres) ---
# Runtime: use the pooled (-pooler) connection string. For db:migrate prefer the
# direct (non-pooler) one.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client. Authorized redirect URI for local dev:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Magic-link email (Resend) ---
AUTH_RESEND_KEY=
# Must be on a domain verified in Resend. Defaults to noreply@tea-ratings.com.
AUTH_RESEND_FROM="LeafScore <noreply@tea-ratings.com>"

# --- Stripe (Premium subscriptions) ---
STRIPE_SECRET_KEY=
# Printed by `stripe listen` locally; from the endpoint settings in production.
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=

# --- Weekly digest cron ---
# Long random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# If unset, /api/cron/digest returns 500 and never sends anything.
CRON_SECRET=

# --- Optional free trial (Stripe Checkout) ---
# Integer 0-30. 0 or unset = no trial.
STRIPE_TRIAL_DAYS=0

# --- Vercel Blob (review photos) ---
BLOB_READ_WRITE_TOKEN=

# --- App ---
# Used for Stripe return URLs and the sitemap. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
